# GEMINI_API_KEY: Khóa API Gemini phía máy chủ cho trợ lý SỬ GIA AI 11.
# AI Studio tự động cung cấp biến này từ bảng Secrets khi chạy.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Đường dẫn triển khai ứng dụng.
APP_URL="http://localhost:3000"

# PORT: Cổng chạy máy chủ Node.js / Express (mặc định 3000).
PORT="3000"

# DATABASE_PATH: Đường dẫn lưu trữ tệp cơ sở dữ liệu SQL bền vững (SQLite).
DATABASE_PATH="./data/lichsu11.sqlite"

# UPLOAD_STORAGE_DIR: Thư mục lưu trữ tệp mô hình .glb và ảnh đại diện tải lên.
UPLOAD_STORAGE_DIR="./public/uploads/models"

# INITIAL_ADMIN_PASSWORD: Mật khẩu khởi tạo quản trị giáo viên cho môi trường thử nghiệm.
# Máy chủ tự động băm bằng Argon2id khi khởi tạo bảng ADMIN_SETTINGS.
INITIAL_ADMIN_PASSWORD="123456"

# SESSION_SECRET: Chuỗi bí mật ký cookie phiên đăng nhập HttpOnly.
SESSION_SECRET="lichsu11-3d-thpt-hoa-minh-secret-change-in-production"
